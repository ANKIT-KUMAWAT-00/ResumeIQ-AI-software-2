APP_ENV=development
APP_NAME=ResumeIQ AI
SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://resumeiq:resumeiq@db:5432/resumeiq
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=resumeiq
RUN_JOBS_INLINE=false
UPLOAD_DIR=/app/private_uploads
OUTPUT_DIR=/app/private_outputs
MAX_UPLOAD_MB=10
RETENTION_DAYS=30
SESSION_COOKIE_NAME=resumeiq_session
SESSION_TTL_HOURS=72
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ALLOW_DEV_OTP=true
ADMIN_EMAILS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ResumeIQ AI <no-reply@example.com>
SMTP_USE_TLS=true

STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_SECONDS=300

NEXT_PUBLIC_API_URL=http://localhost:8000
