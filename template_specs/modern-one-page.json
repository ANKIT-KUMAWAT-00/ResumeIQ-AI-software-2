{
  "template_id": "modern-one-page",
  "version": "1.0.0",
  "display_name": "Modern One-Page",
  "description": "Polished, space-efficient professional layout for concise resumes.",
  "page_size": "LETTER",
  "orientation": "portrait",
  "margins": {
    "top_in": 0.32,
    "bottom_in": 0.32,
    "left_in": 0.48,
    "right_in": 0.48
  },
  "fonts": {
    "family": "Arial",
    "name_pt": 18,
    "heading_pt": 10.5,
    "body_pt": 8.5,
    "small_pt": 7.5,
    "heading_color": "#4338CA",
    "body_color": "#111827"
  },
  "spacing": {
    "line_spacing": 0.92,
    "paragraph_before_pt": 0,
    "paragraph_after_pt": 1,
    "section_before_pt": 4,
    "section_after_pt": 1.2
  },
  "section_order": [
    "education",
    "skills",
    "experience",
    "projects",
    "certifications",
    "achievements",
    "extracurricular"
  ],
  "sections": [
    {
      "id": "education",
      "label": "Education",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "institution",
        "degree",
        "field_of_study",
        "start_date",
        "end_date",
        "details"
      ]
    },
    {
      "id": "skills",
      "label": "Skills",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "category",
        "skills"
      ]
    },
    {
      "id": "experience",
      "label": "Experience",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "title",
        "organization",
        "location",
        "start_date",
        "end_date",
        "bullets"
      ]
    },
    {
      "id": "projects",
      "label": "Projects",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "title",
        "technologies",
        "bullets",
        "url",
        "start_date",
        "end_date"
      ]
    },
    {
      "id": "certifications",
      "label": "Certifications",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "title",
        "issuer",
        "date",
        "details"
      ]
    },
    {
      "id": "achievements",
      "label": "Achievements",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "title",
        "issuer",
        "date",
        "details"
      ]
    },
    {
      "id": "extracurricular",
      "label": "Extracurricular Activities",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
      "heading_underline": false,
      "horizontal_rule": false,
      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "title",
        "organization",
        "date",
        "details"
      ]
    }
  ],
  "bullet_character": "\u2022",
  "bullet_left_indent_in": 0.18,
  "bullet_first_line_indent_in": -0.12,
  "date_tab_position_in": 6.7,
  "contact_separator": " | ",
  "allow_photo": false,
  "max_pages": 1,
  "layout": "single-column",
  "fit_adjustments": {
    "min_body_pt": 7.5,
    "max_body_pt": 11,
    "min_paragraph_after_pt": 0,
    "max_paragraph_after_pt": 6
  },
  "notes_and_uncertainty": [
    "One-page intent is not guaranteed; content is never silently deleted."
  ]
}