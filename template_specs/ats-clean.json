      "rule_thickness_pt": 0.5,
      "rule_spacing_pt": 2,
      "max_items": 20,
      "max_bullets_per_item": 6,
      "allowed_fields": [
        "title",
        "technologies",
        "bullets",
        "url",
        "start_date",
        "end_date"
