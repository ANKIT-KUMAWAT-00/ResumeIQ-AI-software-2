      "max_bullets_per_item": 6,
      "allowed_fields": [
        "category",
        "skills"
      ]
    },
    {
      "id": "experience",
      "label": "Experience",
      "enabled": true,
      "heading_uppercase": true,
      "heading_bold": true,
